          <far>100</far>
        </clip>
        <gz_frame_id>wrist_camera_link</gz_frame_id>
        <optical_frame_id>wrist_camera_color_optical_frame</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <gz_frame_id>wrist_camera_link</gz_frame_id>
      <topic>/sensors/wrist_camera</topic>
    </sensor>
  </gazebo>
