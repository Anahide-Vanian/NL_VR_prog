  <link name="gripper_robotiq_base_link"/>
  <joint name="gripper_robotiq_base_joint" type="fixed">
    <parent link="arm_tool0"/>
    <child link="gripper_robotiq_base_link"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
  </joint>
