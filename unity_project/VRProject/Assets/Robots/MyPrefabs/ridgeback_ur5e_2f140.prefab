--- !u!114 &4166336194681543025
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3422391557532898457}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"front_laser_laser\">\n  <sensor name=\"front_laser\"
    type=\"gpu_lidar\">\n    <update_rate>50</update_rate>\n    <visualize>true</visualize>\n   
    <always_on>true</always_on>\n    <topic>/sensors/front_laser/scan</topic>\n   
    <gz_frame_id>front_laser_laser</gz_frame_id>\n    <lidar>\n      <scan>\n       
    <horizontal>\n          <samples>540</samples>\n          <resolution>1</resolution>\n         
    <min_angle>-2.35619</min_angle>\n          <max_angle>2.35619</max_angle>\n       
    </horizontal>\n        <vertical>\n          <samples>1</samples>\n         
    <resolution>1</resolution>\n          <min_angle>0</min_angle>\n          <max_angle>0</max_angle>\n       
    </vertical>\n      </scan>\n      <range>\n        <min>0.05</min>\n        <max>25.0</max>\n       
    <resolution>0.01</resolution>\n      </range>\n    </lidar>\n  </sensor>\n</gazebo>"
